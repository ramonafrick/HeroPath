# Normalize all text files to LF, in the repository and in the working tree.
* text=auto eol=lf

# Binary files: never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.woff binary
*.woff2 binary

# Batch files need CRLF on Windows.
*.bat text eol=crlf
