@using HeroPath.Modules.Levels.Domain
@using HeroPath.Shared.UI.Components
@inherits LocalizedComponentBase

<div class="level-picker">
    <label class="level-picker-label" for="@_selectId">@Localizer["LevelPicker_Label"]</label>
    <select id="@_selectId"
            class="level-picker-select"
            data-testid="level-picker"
            value="@SelectedId"
            @onchange="HandleChange">
        @foreach (var level in Levels.Where(level => !IsCustomLevel(level)))
        {
            @LevelOption(level)
        }
        @if (Levels.Any(IsCustomLevel))
        {
            <optgroup label="@Localizer["LevelPicker_GroupCustom"]" data-testid="level-picker-group-custom">
                @foreach (var level in Levels.Where(IsCustomLevel))
                {
                    @LevelOption(level)
                }
            </optgroup>
        }
    </select>
</div>

@code {
    private RenderFragment LevelOption(LevelDefinition level) => @<option @key="level.Id"
            value="@level.Id"
            selected="@(level.Id == SelectedId)"
            data-testid="@($"level-picker-option-{level.Id}")"
            data-solved="@(IsSolved?.Invoke(level.Id) == true ? "true" : "false")">@(IsSolved?.Invoke(level.Id) == true ? "✓ " : string.Empty)@Localizer.NameOf(level)</option>;
}
