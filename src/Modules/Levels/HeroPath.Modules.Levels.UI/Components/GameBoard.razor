@using HeroPath.Shared.UI.Components
@using HeroPath.Shared.UI.Graphics
@inherits LocalizedComponentBase

<div class="game-board"
     data-testid="@(Preview ? "board-preview" : "game-board")"
     data-preview="@(Preview ? "true" : null)"
     role="@(Preview ? null : "group")"
     aria-label="@(Preview ? null : Localizer["Board_Label"].Value)"
     aria-hidden="@(Preview ? "true" : null)"
     style="@_boardStyle">
    @for (var y = 0; y < Grid.Height; y++)
    {
        for (var x = 0; x < Grid.Width; x++)
        {
            var position = new Position(x, y);
            var kind = KindAt(position);
            <div class="cell"
                 @key="position"
                 data-testid="@(Preview ? null : $"cell-{x}-{y}")"
                 data-kind="@kind"
                 data-marked="@(IsMarked(position) ? "true" : null)">
                @switch (kind)
                {
                    case "start":
                        <StartField />
                        break;
                    case "goal":
                        <GoalCastle />
                        break;
                    case "tree":
                        <ObstacleTree />
                        break;
                    case "rock":
                        <ObstacleRock />
                        break;
                    case "pond":
                        <ObstaclePond />
                        break;
                }
            </div>
        }
    }
    @if (!Preview)
    {
        <div class="hero"
             data-testid="hero"
             data-x="@HeroPosition.X"
             data-y="@HeroPosition.Y"
             style="@_heroStyle">
            @HeroContent
        </div>
    }
</div>
