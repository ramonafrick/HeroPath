@page "/play"
@inherits SessionComponentBase
@using HeroPath.Modules.Game.Application
@using HeroPath.Modules.Game.UI.Components
@using HeroPath.Modules.Levels.UI.Components

<PageTitle>@SharedLocalizer["App_Title"]</PageTitle>

@if (Choice.IsChosen && Session.Grid is { } grid && Session.Level is { } level)
{
    <main class="play-page" data-wide="@(grid.Width >= 2 * grid.Height ? "true" : null)">
        <section class="board-area" data-has-items="@(grid.Items.Count > 0 ? "true" : null)" style="--board-cols: @grid.Width; --board-rows: @grid.Height;">
            <div class="board-head">
                <h2 class="level-name" data-testid="level-name">@LevelsLocalizer[$"Level_{level.Id}"]</h2>
                <HeroBadge />
            </div>
            <ItemCounter />
            <GameBoard Grid="grid"
                       HeroPosition="Session.HeroPosition"
                       MarkedCell="Session.MarkedCell"
                       CollectedItems="Session.CollectedItems"
                       StepDuration="Session.Tempo.Duration">
                <HeroContent>
                    <HeroFigure Avatar="Choice.Avatar" />
                </HeroContent>
            </GameBoard>
        </section>
        <aside class="side-panel" data-testid="side-panel">
            <div class="side-tools">
                <LevelPicker Levels="Progress.Levels"
                             SelectedId="@level.Id"
                             IsSolved="Progress.IsSolved"
                             SelectedIdChanged="SwitchLevel" />
                <BlockPalette />
                <ControlBar />
                <MessageBox />
                @if (Session.Status == RunStatus.Succeeded && Progress.NextAfter(level.Id) is { } next)
                {
                    <button type="button" class="next-level" data-testid="next-level" @onclick="() => LoadLevel(next)">@GameLocalizer["Level_Next"]</button>
                }
            </div>
            <ProgramEditor />
        </aside>
    </main>
}
