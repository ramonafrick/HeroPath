@page "/"
@inherits SessionComponentBase
@using HeroPath.Modules.Game.UI.Components
@using HeroPath.Modules.Levels.UI.Components
@using HeroPath.Shared.UI.Graphics

<PageTitle>@Localizer["App_Title"]</PageTitle>

<main class="play-page">
    <section class="board-area" style="--board-cols: @Session.Grid!.Width; --board-rows: @Session.Grid!.Height;">
        <h2 class="level-name" data-testid="level-name">@LevelsLocalizer[$"Level_{_level.Id}"]</h2>
        <GameBoard Grid="Session.Grid!"
                   HeroPosition="Session.HeroPosition"
                   MarkedCell="Session.MarkedCell"
                   StepDuration="Session.Tempo.Duration">
            <HeroContent>
                <HeroMax />
            </HeroContent>
        </GameBoard>
    </section>
    <aside class="side-panel" data-testid="side-panel">
        <div class="side-tools">
            <BlockPalette />
            <ControlBar />
            <MessageBox />
        </div>
        <ProgramEditor />
    </aside>
</main>
