@page "/"
@inherits LocalizedComponentBase
@using HeroPath.Modules.Game.UI.Components
@using HeroPath.Modules.Levels.Domain
@using HeroPath.Modules.Levels.UI
@using HeroPath.Modules.Levels.UI.Components
@using HeroPath.Shared.UI.Components

<PageTitle>@SharedLocalizer["App_Title"]</PageTitle>

<main class="start-page" data-testid="start-page">
    <section class="start-intro">
        <h2 class="start-title">@GameLocalizer["Start_Title"]</h2>
        <p class="start-text">@GameLocalizer["Start_Intro"]</p>
    </section>

    <div class="start-setup">
        <section class="start-heroes" aria-labelledby="start-hero-title">
            <h3 id="start-hero-title" class="start-section-title">@GameLocalizer["Start_HeroGroup"]</h3>
            <div class="hero-cards">
                @foreach (var avatar in Avatars)
                {
                    <button type="button"
                            class="hero-card"
                            data-testid="@($"hero-{avatar.ToSlug()}")"
                            aria-pressed="@(_avatar == avatar ? "true" : "false")"
                            @onclick="() => SelectAvatar(avatar)">
                        <span class="hero-card-figure">
                            <HeroFigure Avatar="avatar" />
                        </span>
                        <span class="hero-card-name">@HeroChoice.DefaultName(avatar)</span>
                    </button>
                }
            </div>
        </section>

        <section class="start-name">
            <label class="start-name-label" for="hero-name">@GameLocalizer["Start_NameLabel"]</label>
            <input id="hero-name"
                   class="start-name-input"
                   data-testid="hero-name"
                   type="text"
                   maxlength="@HeroChoice.MaxNameLength"
                   autocomplete="off"
                   aria-describedby="hero-name-hint"
                   @bind="_name"
                   @bind:event="oninput" />
            <span id="hero-name-hint" class="start-name-hint">@GameLocalizer["Start_NameHint"]</span>
        </section>

        <button type="button" class="start-go" data-testid="start-go" @onclick="Go">@GameLocalizer["Start_Go"]</button>
        <button type="button" class="start-build" data-testid="start-build" @onclick="Build">@GameLocalizer["Start_Build"]</button>
    </div>

    <div class="start-levels">
        <section class="start-standard-levels" aria-labelledby="start-levels-title">
            <h3 id="start-levels-title" class="start-section-title">@GameLocalizer["Start_LevelsTitle"]</h3>
            <div class="level-cards">
                @foreach (var level in Repository.Standard)
                {
                    @LevelCard(level)
                }
            </div>
        </section>

        @if (Repository.Custom.Count > 0)
        {
            <section class="start-custom-levels" data-testid="custom-levels" aria-labelledby="start-custom-levels-title">
                <h3 id="start-custom-levels-title" class="start-section-title">@GameLocalizer["Start_CustomLevelsTitle"]</h3>
                <div class="level-cards">
                    @foreach (var level in Repository.Custom)
                    {
                        @LevelCard(level)
                    }
                </div>
            </section>
        }
    </div>
</main>

@code {
    private RenderFragment LevelCard(LevelDefinition level) => @<div class="level-card"
         @key="level.Id"
         data-solved="@(Progress.IsSolved(level.Id) ? "true" : "false")"
         data-selected="@(_levelId == level.Id ? "true" : "false")">
        <span class="level-preview" data-testid="@($"level-preview-{level.Id}")" aria-hidden="true">
            <GameBoard Grid="GridOf(level)" Preview="true" />
        </span>
        <button type="button"
                class="level-card-button"
                data-testid="@($"level-card-{level.Id}")"
                data-solved="@(Progress.IsSolved(level.Id) ? "true" : "false")"
                aria-label="@(Progress.IsSolved(level.Id) ? $"{LevelsLocalizer.NameOf(level)}, {GameLocalizer["Level_Solved"]}" : null)"
                aria-pressed="@(_levelId == level.Id ? "true" : "false")"
                @onclick="() => SelectLevel(level.Id)">
            <span class="level-card-name">@LevelsLocalizer.NameOf(level)</span>
        </button>
        @if (Progress.IsSolved(level.Id))
        {
            <svg class="level-solved-badge" data-testid="@($"level-solved-{level.Id}")" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle class="badge-shape" cx="12" cy="12" r="10.5" />
                <path class="badge-glyph" d="M6.5 12.5 L10.5 16.5 L17.5 8" />
            </svg>
        }
    </div>;
}
