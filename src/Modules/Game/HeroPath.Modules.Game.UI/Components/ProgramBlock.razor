@inherits DragAwareComponentBase

@{
    RenderFragment actions =
        @<div class="block-actions">
            <button type="button"
                    class="block-action"
                    data-testid="program-up"
                    aria-label="@Localizer["Program_MoveUp", Number]"
                    disabled="@(!Session.CanMoveUp(Command.Id))"
                    @onclick="() => Session.MoveUp(Command.Id)">
                <ProgramIcon Kind="ProgramIconKind.Up" />
            </button>
            <button type="button"
                    class="block-action"
                    data-testid="program-down"
                    aria-label="@Localizer["Program_MoveDown", Number]"
                    disabled="@(!Session.CanMoveDown(Command.Id))"
                    @onclick="() => Session.MoveDown(Command.Id)">
                <ProgramIcon Kind="ProgramIconKind.Down" />
            </button>
            <button type="button"
                    class="block-action"
                    data-testid="program-remove"
                    aria-label="@Localizer["Program_Remove", Number]"
                    disabled="@(!IsEditable)"
                    @onclick="() => Session.Remove(Command.Id)">
                <ProgramIcon Kind="ProgramIconKind.Remove" />
            </button>
        </div>;
}
<li class="program-block"
    data-testid="program-block"
    data-path="@Number"
    data-kind="@(IsMove ? "move" : "repeat")"
    data-selected="@(IsSelected ? "true" : "false")"
    data-command-id="@Command.Id"
    data-direction="@((Command as MoveCommand)?.Direction.ToSlug())"
    data-current="@(IsCurrent ? "true" : null)"
    data-error="@(IsError ? "true" : null)"
    data-hint="@(IsHinted ? "true" : null)"
    data-active-repeat="@(IsActiveRepeat ? "true" : null)">
    <div class="block-row"
         draggable="@(IsEditable ? "true" : "false")"
         data-testid="@($"block-row-{Number}")"
         data-dragging="@(Drag.Source is DragSource.Existing { Id: var dragged } && dragged == Command.Id ? "true" : null)"
         @ondragstart="StartDrag"
         @ondragend="Drag.End">
        <div class="block-head" data-testid="@($"block-head-{Number}")">
            <button type="button"
                    class="block-select"
                    data-testid="@($"program-select-{Number}")"
                    aria-pressed="@(IsSelected ? "true" : "false")"
                    aria-label="@Localizer["Program_Block", Number, Name]"
                    @onclick="() => Session.Select(Command.Id)">
                <span class="program-number" aria-hidden="true">@Number</span>
                @if (Command is MoveCommand moveCommand)
                {
                    <DirectionIcon Direction="moveCommand.Direction" />
                    <span class="program-text">@Name</span>
                }
                else
                {
                    @if (Path.Count == 1)
                    {
                        <ProgramIcon Kind="ProgramIconKind.Repeat" />
                    }
                    <span class="program-text">@Localizer["Repeat_Before"]</span>
                }
            </button>
            @if (Command is RepeatCommand header)
            {
                <button type="button"
                        class="block-action"
                        data-testid="@($"repeat-minus-{Number}")"
                        aria-label="@Localizer["Repeat_Decrease", Number]"
                        disabled="@(!IsEditable || header.Count <= ProgramLimits.MinRepeatCount)"
                        @onclick="() => Session.SetRepeatCount(header.Id, header.Count - 1)">
                    <ProgramIcon Kind="ProgramIconKind.Minus" />
                </button>
                <span class="repeat-count" data-testid="@($"repeat-count-{Number}")">@header.Count</span>
                <button type="button"
                        class="block-action"
                        data-testid="@($"repeat-plus-{Number}")"
                        aria-label="@Localizer["Repeat_Increase", Number]"
                        disabled="@(!IsEditable || header.Count >= ProgramLimits.MaxRepeatCount)"
                        @onclick="() => Session.SetRepeatCount(header.Id, header.Count + 1)">
                    <ProgramIcon Kind="ProgramIconKind.Plus" />
                </button>
                <span class="repeat-after" data-testid="@($"repeat-after-{Number}")">@Localizer["Repeat_After"]</span>
            }
        </div>
        @if (IsMove && IsSelected)
        {
            @actions
        }
        @if (!IsMove && (IsSelected || Progress is not null))
        {
            <div class="block-foot">
                @if (Progress is { } round)
                {
                    <span class="repeat-round" data-testid="@($"repeat-round-{Number}")">@Localizer["Repeat_Round", round.Round, round.Count]</span>
                }
                @if (IsSelected)
                {
                    @actions
                }
            </div>
        }
        @if (IsCurrent)
        {
            <svg class="program-marker" role="img" aria-label="@Localizer[IsError ? "Program_Error" : "Program_Current"]" viewBox="0 0 24 24" focusable="false">
                @if (IsError)
                {
                    <path class="marker-shape" d="M12 2.5 L22.5 21 H1.5 Z" />
                    <path class="marker-glyph" d="M12 9 V14.5 M12 17.8 V18" />
                }
                else
                {
                    <circle class="marker-shape" cx="12" cy="12" r="10" />
                    <path class="marker-glyph-fill" d="M9.5 7 L17 12 L9.5 17 Z" />
                }
            </svg>
        }
        @if (IsHinted)
        {
            <svg class="program-marker" role="img" aria-label="@Localizer["Program_Hint"]" viewBox="0 0 24 24" focusable="false">
                <circle class="marker-shape" cx="12" cy="12" r="10" />
                <path class="marker-glyph" d="M12 11 V17 M12 6.8 V7" />
            </svg>
        }
    </div>
    @if (Command is RepeatCommand repeatCommand)
    {
        <ol class="repeat-body" data-testid="@($"repeat-body-{Number}")">
            <BlockList ParentId="repeatCommand.Id" ParentNumber="@Number" Commands="repeatCommand.Body" PathPrefix="Path" />
        </ol>
    }
</li>
