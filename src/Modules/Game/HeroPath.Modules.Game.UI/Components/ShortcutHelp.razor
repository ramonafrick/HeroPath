@inherits LocalizedComponentBase
@using HeroPath.Shared.UI.Components

<details class="shortcut-help" data-testid="shortcut-help" open="@Open">
    <summary class="shortcut-summary" data-testid="shortcut-help-toggle" aria-disabled="@(Disabled ? "true" : null)" @onclick="ToggleAsync" @onclick:preventDefault>@Localizer["Shortcuts_Title"]</summary>
    <div class="shortcut-body" data-testid="shortcut-help-body">
        <ul class="shortcut-list">
            <li>
                <span class="keys" role="group" aria-label="@Localizer["Shortcuts_Key_Arrows"]">
                    <kbd>←</kbd><kbd>↑</kbd><kbd>→</kbd><kbd>↓</kbd>
                </span>
                <span class="action">@Localizer["Shortcuts_Insert"]</span>
            </li>
            <li>
                <span class="keys"><kbd>@Localizer["Shortcuts_Key_Shift"]</kbd><span aria-hidden="true">+</span><kbd>↑</kbd><kbd>↓</kbd></span>
                <span class="action">@Localizer["Shortcuts_Move"]</span>
            </li>
            <li>
                <span class="keys"><kbd>@Localizer["Shortcuts_Key_Delete"]</kbd><kbd>@Localizer["Shortcuts_Key_Backspace"]</kbd></span>
                <span class="action">@Localizer["Shortcuts_Delete"]</span>
            </li>
            <li>
                <span class="keys"><kbd>@Localizer["Shortcuts_Key_Escape"]</kbd></span>
                <span class="action">@Localizer["Shortcuts_Deselect"]</span>
            </li>
            <li>
                <span class="keys"><kbd>@Localizer["Shortcuts_Key_Space"]</kbd></span>
                <span class="action">@Localizer["Shortcuts_Play"]</span>
            </li>
            <li>
                <span class="keys"><kbd>D</kbd></span>
                <span class="action">@Localizer["Shortcuts_Debug"]</span>
            </li>
            <li>
                <span class="keys"><kbd>R</kbd></span>
                <span class="action">@Localizer["Shortcuts_Reset"]</span>
            </li>
        </ul>
    </div>
</details>
