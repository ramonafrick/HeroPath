@inherits SessionComponentBase

<section class="program" aria-labelledby="program-title">
    <div class="program-header">
        <h3 id="program-title" class="program-title">@Localizer["Program_Title"]</h3>
        <button type="button"
                class="program-clear"
                data-testid="program-clear"
                disabled="@(!Session.IsEditable)"
                @onclick="Session.Clear">
            @Localizer["Program_Clear"]
        </button>
    </div>
    @if (Session.Commands.Count == 0)
    {
        <p class="program-empty" data-testid="program-empty">@Localizer["Program_Empty"]</p>
    }
    <ol class="program-list" data-testid="program">
        @for (var index = 0; index < Session.Commands.Count; index++)
        {
            var command = Session.Commands[index];
            var number = index + 1;
            var position = index;
            var name = Localizer[$"Block_{command.Direction}"];
            var isCurrent = Session.CurrentStep?.CommandId == command.Id;
            var isError = isCurrent && Session.Status == RunStatus.Failed;
            <li @key="command.Id"
                class="program-block"
                data-testid="program-block"
                data-index="@position"
                data-command-id="@command.Id"
                data-direction="@command.Direction.ToSlug()"
                data-current="@(isCurrent ? "true" : null)"
                data-error="@(isError ? "true" : null)"
                aria-label="@Localizer["Program_Block", number, name]">
                <span class="program-number" aria-hidden="true">@number</span>
                <DirectionIcon Direction="command.Direction" />
                <span class="program-text">@name</span>
                @if (isCurrent)
                {
                    <svg class="program-marker" role="img" aria-label="@Localizer[isError ? "Program_Error" : "Program_Current"]" viewBox="0 0 24 24" focusable="false">
                        @if (isError)
                        {
                            <path class="marker-shape" d="M12 2.5 L22.5 21 H1.5 Z" />
                            <path class="marker-glyph" d="M12 9 V14.5 M12 17.8 V18" />
                        }
                        else
                        {
                            <circle class="marker-shape" cx="12" cy="12" r="10" />
                            <path class="marker-glyph-fill" d="M9.5 7 L17 12 L9.5 17 Z" />
                        }
                    </svg>
                }
                <button type="button"
                        class="program-remove"
                        data-testid="@($"program-remove-{position}")"
                        aria-label="@Localizer["Program_Remove", number]"
                        disabled="@(!Session.IsEditable)"
                        @onclick="() => Session.Remove(command.Id)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3.5 6.5 H20.5 M9 6.5 V3.5 H15 V6.5 M5.5 6.5 L6.7 20.5 H17.3 L18.5 6.5 M10 10.5 V16.5 M14 10.5 V16.5" />
                    </svg>
                </button>
            </li>
        }
    </ol>
</section>
