@inherits SessionComponentBase

@{
    var target = Session.InsertTarget;
    var targetNumber = target.ParentId is { } parentId && Session.Program.PathOf(parentId) is { } path ? string.Join(".", path) : null;
}
<section class="program" aria-labelledby="program-title">
    <div class="program-header">
        <h3 id="program-title" class="program-title">@Localizer["Program_Title"]</h3>
        <button type="button"
                class="program-clear"
                data-testid="program-clear"
                disabled="@(!Session.IsEditable)"
                @onclick="Session.Clear">
            @Localizer["Program_Clear"]
        </button>
    </div>
    <p class="insert-target" data-testid="insert-target" data-target="@(targetNumber ?? "root")">
        @(targetNumber is null ? Localizer["InsertTarget_Root"] : Localizer["InsertTarget_Repeat", targetNumber])
    </p>
    <ol class="program-list" data-testid="program">
        @for (var index = 0; index < Session.Program.Commands.Count; index++)
        {
            var command = Session.Program.Commands[index];
            <ProgramBlock @key="command.Id" Command="command" Path="[index + 1]" />
        }
    </ol>
</section>
