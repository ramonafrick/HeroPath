@inherits SessionComponentBase

<div class="message-live" aria-live="polite">
    @if (Session.Message is { } message)
    {
        <p class="message"
           data-testid="message"
           data-kind="@message.Kind.ToSlug()"
           data-code="@message.Code">
            <svg class="message-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                @switch (message.Kind)
                {
                    case GameMessageKind.Error:
                        <path class="shape" d="M12 2.5 L22.5 21 H1.5 Z" />
                        <path class="glyph" d="M12 9 V14.5 M12 17.8 V18" />
                        break;
                    case GameMessageKind.Success:
                        <path class="shape" d="M12 1.8 L15 8.6 L22.4 9.3 L16.8 14.2 L18.5 21.5 L12 17.7 L5.5 21.5 L7.2 14.2 L1.6 9.3 L9 8.6 Z" />
                        break;
                    default:
                        <circle class="shape" cx="12" cy="12" r="10.5" />
                        <path class="glyph" d="M12 11 V17 M12 6.8 V7" />
                        break;
                }
            </svg>
            <span class="message-text">@Text(message)</span>
        </p>
    }
</div>
