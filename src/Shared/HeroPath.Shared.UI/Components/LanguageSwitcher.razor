<div class="language-switcher" role="group" aria-label="@Localizer["Language_Switch_Label"]">
    <button type="button"
            class="language-button"
            data-testid="language-de"
            lang="de"
            title="@Localizer["Language_German"]"
            aria-pressed="@IsActive(LanguageService.German)"
            @onclick="() => SelectAsync(LanguageService.German)">
        @Localizer["Language_German_Short"]
    </button>
    <button type="button"
            class="language-button"
            data-testid="language-en"
            lang="en"
            title="@Localizer["Language_English"]"
            aria-pressed="@IsActive(LanguageService.English)"
            @onclick="() => SelectAsync(LanguageService.English)">
        @Localizer["Language_English_Short"]
    </button>
</div>
